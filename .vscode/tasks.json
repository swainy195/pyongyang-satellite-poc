{
  "version": "2.0.0",
  "tasks": [
    { "label": "API: dev", "type": "shell", "command": "uv run uvicorn app.main:app --reload --port 8000", "options": { "cwd": "${workspaceFolder}/apps/api" }, "isBackground": true, "problemMatcher": [] },
    { "label": "Web: dev", "type": "shell", "command": "pnpm dev", "options": { "cwd": "${workspaceFolder}/apps/web" }, "isBackground": true, "problemMatcher": [] },
    { "label": "Supabase: start", "type": "shell", "command": "supabase start", "problemMatcher": [] },
    { "label": "Supabase: reset", "type": "shell", "command": "supabase db reset", "problemMatcher": [] },
    { "label": "ETL: inspect", "type": "shell", "command": "uv run python -m pipelines.etl.inspect_inputs --input-dir data/import", "problemMatcher": [] },
    { "label": "Test: all", "type": "shell", "command": "make test", "group": "test", "problemMatcher": [] },
    { "label": "Lint: all", "type": "shell", "command": "make lint", "problemMatcher": [] }
  ]
}
